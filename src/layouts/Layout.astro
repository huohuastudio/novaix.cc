---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Novaix — 商业化 IDC 管理系统",
  description = "面向中小型 VPS 服务商的一站式 IDC 管理系统。单文件部署，开箱即用。",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://novaix.cc").href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <!-- 在首次绘制前应用主题，避免闪烁。默认亮色，可选 dark / auto（跟随系统） -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "dark" && t !== "auto") t = "light";
        var root = document.documentElement;
        root.dataset.theme = t;
        root.classList.toggle("dark", t === "dark" || (t === "auto" && matchMedia("(prefers-color-scheme: dark)").matches));
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="VPS管理系统,IDC管理,主机销售系统,服务器管理,虚拟化管理面板,云主机管理,VPS面板,主机商系统" />
    <meta name="author" content="Spark Studio" />
    <meta name="theme-color" content="#05070d" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://novaix.cc/og-image.png" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Novaix" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://novaix.cc/og-image.png" />

    <link rel="canonical" href={canonicalURL} />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QK0XF8CE4M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QK0XF8CE4M');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;700;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-clip bg-white text-zinc-800 antialiased dark:bg-depth dark:text-slate-300">
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
      );
      document.querySelectorAll("[data-animate]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
