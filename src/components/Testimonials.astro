---
const testimonials = [
  {
    quote: "之前用 SolusVM，迁移到 Novaix 后运维效率提升了一个量级。单文件部署太省心了，更新也是后台一键搞定。",
    name: "张明",
    role: "IDC 运维负责人",
  },
  {
    quote: "SQLite 零依赖开箱即用，小规模起步完全不需要折腾数据库。等业务大了再切 MySQL 也来得及。",
    name: "李强",
    role: "VPS 服务商",
  },
  {
    quote: "代理分销体系做得很灵活，差异化返佣和折扣矩阵帮我们快速建立了分销网络。",
    name: "王磊",
    role: "主机代理商",
  },
  {
    quote: "工单系统、公告、CMS、优惠券这些运营工具全都内置了，不用再额外对接第三方。一个系统搞定所有事情。",
    name: "赵鹏",
    role: "云服务创业者",
  },
  {
    quote: "HA 高可用和热迁移功能让我们节点维护时不用再通知客户了，业务完全不中断。这才是生产级该有的样子。",
    name: "陈刚",
    role: "数据中心管理员",
  },
  {
    quote: "从下载到跑起来第一个实例，真的只用了不到十分钟。文档写得很清楚，插件也是一键装好。",
    name: "周浩",
    role: "个人站长",
  },
];
---
<section class="page-section">
  <div class="mx-auto max-w-6xl">
    <div data-animate>
      <h2 class="section-title">
        用户怎么说
      </h2>
      <p class="section-lead">来自正在使用 Novaix 的服务商。</p>
    </div>

    <div class="mt-12 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3" data-animate style="--stagger:.1s">
      {testimonials.map((t) => (
        <figure class="flex flex-col justify-between border-t border-zinc-200 dark:border-white/[0.08] py-7">
          <blockquote class="text-[0.95rem] leading-relaxed text-zinc-700 dark:text-slate-200">
            {t.quote}
          </blockquote>
          <figcaption class="mt-5 text-sm">
            <span class="font-medium text-zinc-900 dark:text-white">{t.name}</span>
            <span class="ml-2 text-zinc-500 dark:text-slate-500">{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
