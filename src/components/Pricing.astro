---
interface Feature {
  name: string;
  free: boolean;
  // 不是简单的有/无时，分别给出两个版本的说明文字
  freeText?: string;
  proText?: string;
}

const features: Feature[] = [
  { name: "节点数", free: true, freeText: "最多 2 个", proText: "不限" },
  { name: "实例全生命周期管理", free: true },
  { name: "套餐 / 订单 / 计费", free: true },
  { name: "多支付渠道", free: true },
  { name: "工单系统", free: true },
  { name: "CMS 内容管理", free: true },
  { name: "主题系统", free: true },
  { name: "在线更新", free: true },
  { name: "发票系统", free: true },
  { name: "实例转移", free: true },
  { name: "HA 高可用（自动疏散）", free: false },
  { name: "告警通知", free: false },
  { name: "私有网络（VPC）", free: false },
  { name: "代理商系统", free: false },
  { name: "共享 IP / NAT / 纯 IPv6", free: false },
  { name: "插件系统", free: false },
  { name: "集成方（API / Webhook）", free: false },
  { name: "品牌自定义", free: false },
  { name: "团队成员", free: false },
];
---

<section id="pricing" class="page-section">
  <div class="mx-auto max-w-6xl">
    <div data-animate>
      <h2 class="section-title">
        免费版与授权版
      </h2>
      <p class="section-lead">
        部署即用，无需注册。免费版满足小规模运营，授权版解锁全部能力。
      </p>
    </div>

    <div class="mt-12 overflow-hidden rounded-md border border-zinc-200 dark:border-white/[0.08]" data-animate style="--stagger:.1s">
      <table class="w-full table-fixed text-sm">
        <colgroup>
          <col class="w-[40%]" />
          <col />
          <col />
        </colgroup>
        <thead>
          <tr class="align-top">
            <td class="p-4 sm:p-6"></td>
            <th scope="col" class="p-4 text-left font-normal sm:p-6">
              <div class="font-display text-base font-bold text-zinc-900 dark:text-white sm:text-lg">免费版</div>
              <div class="mt-3 font-display text-3xl font-bold text-zinc-900 dark:text-white sm:text-4xl">¥0</div>
              <div class="mt-2 text-xs text-zinc-500 dark:text-slate-400 sm:text-sm">永久免费</div>
              <a
                href="https://github.com/huohuastudio/novaix-releases/releases"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 flex items-center justify-center rounded-lg border border-zinc-300 dark:border-white/15 py-2.5 text-sm font-medium text-zinc-700 dark:text-slate-200 transition-all hover:border-zinc-400 dark:hover:border-white/30 hover:bg-zinc-100 dark:hover:bg-white/10"
              >
                免费下载
              </a>
            </th>
            <th scope="col" class="border-l border-brand/40 bg-brand/[0.08] p-4 text-left font-normal sm:p-6">
              <div class="font-display text-base font-bold text-zinc-900 dark:text-white sm:text-lg">授权版</div>
              <div class="mt-3 font-display text-3xl font-bold text-zinc-900 dark:text-white sm:text-4xl">按需</div>
              <div class="mt-2 text-xs text-zinc-500 dark:text-slate-400 sm:text-sm">订阅制，不限规模</div>
              <a
                href="https://huohuastudio.com/products/novaix/buy"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-5 flex items-center justify-center rounded-lg bg-brand py-2.5 text-sm font-semibold text-white dark:shadow-[0_0_30px_-8px_rgba(47,107,255,0.95)] transition-colors hover:bg-brand-light"
              >
                获取授权
              </a>
            </th>
          </tr>
        </thead>
        <tbody>
          {features.map((f) => (
            <tr class="border-t border-zinc-200/70 dark:border-white/[0.06]">
              <th scope="row" class="px-4 py-3 text-left font-normal text-zinc-600 dark:text-slate-300 sm:px-6">{f.name}</th>
              <td class="px-4 py-3 sm:px-6">
                {f.freeText ? (
                  <span class="text-zinc-600 dark:text-slate-300">{f.freeText}</span>
                ) : f.free ? (
                  <svg class="h-4 w-4 text-zinc-600 dark:text-slate-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" role="img" aria-label="包含"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                ) : (
                  <svg class="h-4 w-4 text-zinc-300 dark:text-slate-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" role="img" aria-label="不包含"><path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6"/></svg>
                )}
              </td>
              <td class="border-l border-brand/40 bg-brand/[0.08] px-4 py-3 sm:px-6">
                {f.proText ? (
                  <span class="font-medium text-zinc-900 dark:text-white">{f.proText}</span>
                ) : (
                  <svg class="h-4 w-4 text-brand dark:text-glow" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" role="img" aria-label="包含"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
