<!-- 波浪网格背景 -->
<canvas id="wave-canvas" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("wave-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  let w = 0, h = 0;

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio, 2);
    w = rect.width;
    h = rect.height;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    canvas.style.width = w + "px";
    canvas.style.height = h + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  resize();
  window.addEventListener("resize", resize, { passive: true });

  const COLS = 48;
  const ROWS = 28;
  const SPACING_X = 1920 / (COLS - 1);
  const SPACING_Y = 1080 / (ROWS - 1);

  let reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  window.matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", e => {
    reducedMotion = e.matches;
  });

  let time = 0;

  function draw() {
    if (reducedMotion) {
      drawFrame(0);
      return;
    }
    time += 0.008;
    drawFrame(time);
    requestAnimationFrame(draw);
  }

  function drawFrame(t: number) {
    ctx.clearRect(0, 0, w, h);

    const scaleX = w / 1920;
    const scaleY = h / 1080;

    for (let row = 0; row < ROWS; row++) {
      for (let col = 0; col < COLS; col++) {
        const baseX = col * SPACING_X;
        const baseY = row * SPACING_Y;

        // 多层波叠加
        const wave1 = Math.sin(col * 0.15 + t * 1.2) * Math.cos(row * 0.12 + t * 0.8);
        const wave2 = Math.sin(col * 0.08 + row * 0.06 + t * 0.6) * 0.5;
        const wave3 = Math.cos(col * 0.12 - row * 0.1 + t * 1.5) * 0.3;
        const wave = wave1 + wave2 + wave3;

        const offsetY = wave * 18;
        const offsetX = Math.sin(row * 0.1 + t * 0.5) * 6;

        const x = (baseX + offsetX) * scaleX;
        const y = (baseY + offsetY) * scaleY;

        // 波峰亮、波谷暗
        const intensity = (wave + 1.8) / 3.6; // normalize to 0~1
        const alpha = 0.08 + intensity * 0.35;
        const radius = (1 + intensity * 1.8) * Math.min(scaleX, scaleY);

        // 高亮点带光晕
        if (intensity > 0.7) {
          const glowR = radius * 4;
          const grad = ctx.createRadialGradient(x, y, 0, x, y, glowR);
          grad.addColorStop(0, `rgba(129, 140, 248, ${(intensity - 0.7) * 0.5})`);
          grad.addColorStop(1, "rgba(129, 140, 248, 0)");
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(x, y, glowR, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.fillStyle = intensity > 0.6
          ? `rgba(165, 180, 252, ${alpha})`
          : `rgba(148, 163, 184, ${alpha})`;
        ctx.beginPath();
        ctx.arc(x, y, radius, 0, Math.PI * 2);
        ctx.fill();
      }
    }
  }

  requestAnimationFrame(draw);
</script>
