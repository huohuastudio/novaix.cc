<!-- 机房走廊背景：一点透视的机柜长廊，启动时光波从尽头冲向镜头并逐排点亮机柜 -->
<canvas id="aisle-canvas" class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("aisle-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const stage = canvas.parentElement!;

  // ── 场景尺寸（世界单位） ──
  const RACK_H = 3; // 机柜高度
  const CEIL = 3.5; // 天花板高度
  const EYE = 1.3; // 镜头高度
  const PITCH = 1; // 机柜间距（沿走廊方向）
  const RACK_W = 0.92;
  const ROWS = 13; // 每个机柜的设备层数
  const NEAR = 0.35;
  const DEPTH = 44; // 可见机柜排数
  const BOOT_AT = 0.45; // 启动光波出发时间（秒）
  const BOOT_SPEED = 28;

  // 青、蓝、绿、琥珀、白
  const LED_COLORS = ["46,230,255", "70,130,255", "52,245,164", "255,184,48", "225,245,255"];
  const LED_FILL = LED_COLORS.map((c) => `rgb(${c})`);
  const WAVE_START = DEPTH - 4; // 光波出发的深度
  const PLANES = [0, CEIL]; // 地面与天花板
  const TUBE_X = [-0.45, 0.45]; // 两排灯管的横向位置
  const REFLECT_W = [0.1, 0.18, 0.28, 0.4];

  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const rackKey = (i: number, side: number) => i * 2 + side;

  let W = 0, H = 0;
  let f = 600; // 焦距
  let A = 3; // 走廊半宽
  let vpx = 0, vpy = 0; // 消失点
  let dim = 1; // 小屏整体降低亮度，保证文字可读

  // 泛光：把画面两次缩小再放大叠回去，得到柔和的辉光
  const mid = document.createElement("canvas");
  const bloom = document.createElement("canvas");
  const mctx = mid.getContext("2d")!;
  const bctx = bloom.getContext("2d")!;

  function resize() {
    const rect = stage.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = rect.width;
    H = rect.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    mid.width = Math.ceil(W / 3);
    mid.height = Math.ceil(H / 3);
    bloom.width = Math.ceil(W / 9);
    bloom.height = Math.ceil(H / 9);
    f = Math.max(W * 0.5, H * 0.55);
    A = clamp((W / H) * 1.75, 1.15, 3);
    dim = W < 640 ? 0.6 : 1;
  }

  // ── 机柜数据：按全局序号惰性生成，保证镜头前进时同一机柜外观稳定 ──
  interface Led { u: number; c: number; rate: number; phase: number; delay: number }
  interface Rack { rows: Led[][]; tOn: number }
  const racks = new Map<number, Rack>();

  function rng(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function getRack(i: number, side: number): Rack {
    const key = rackKey(i, side);
    let rack = racks.get(key);
    if (rack) return rack;
    const rnd = rng((key + 11) * 2654435761);
    const rows: Led[][] = [];
    for (let r = 0; r < ROWS; r++) {
      const leds: Led[] = [];
      if (rnd() > 0.12) {
        const n = 1 + Math.floor(rnd() * 3);
        for (let k = 0; k < n; k++) {
          const p = rnd();
          leds.push({
            u: 0.08 + k * 0.1,
            c: p < 0.5 ? 0 : p < 0.74 ? 1 : p < 0.93 ? 2 : p < 0.97 ? 3 : 4,
            rate: rnd() < 0.3 ? 3 + rnd() * 14 : 0,
            phase: rnd() * 6.28,
            delay: r * 0.025 + rnd() * 0.3,
          });
        }
        // 右侧的活动指示灯
        if (rnd() < 0.45) {
          leds.push({ u: 0.86, c: 0, rate: 8 + rnd() * 20, phase: rnd() * 6.28, delay: r * 0.025 + rnd() * 0.4 });
        }
      }
      rows.push(leds);
    }
    // 启动光波从走廊尽头冲向镜头，越近的机柜越晚点亮
    const tOn = i <= DEPTH ? BOOT_AT + Math.max(0, WAVE_START - i * PITCH) / BOOT_SPEED : 0;
    rack = { rows, tOn };
    racks.set(key, rack);
    return rack;
  }

  // ── 光轨上的数据流 ──
  // 轨道位置：x 为走廊半宽的比例，y 为世界高度
  const RAILS = [
    { x: -1, y: RACK_H + 0.05 }, { x: 1, y: RACK_H + 0.05 },
    { x: -1, y: 0 }, { x: 1, y: 0 },
    { x: -0.5, y: 0 }, { x: 0, y: 0 }, { x: 0.5, y: 0 },
    { x: -0.45, y: CEIL }, { x: 0.45, y: CEIL },
  ];
  interface Packet { rail: number; z: number; v: number; len: number; c: number }
  const packets: Packet[] = [];
  const prnd = rng(7);
  function spawn(p: Packet, fresh: boolean) {
    p.rail = Math.floor(prnd() * RAILS.length);
    const toward = prnd() < 0.7;
    p.v = (toward ? -1 : 1) * (7 + prnd() * 12);
    p.len = 1.2 + prnd() * 2.6;
    p.c = prnd() < 0.7 ? 0 : 4;
    p.z = fresh ? NEAR + prnd() * DEPTH : toward ? DEPTH : NEAR;
  }
  for (let i = 0; i < 16; i++) {
    const p = { rail: 0, z: 0, v: 0, len: 0, c: 0 };
    spawn(p, true);
    packets.push(p);
  }

  // ── 镜头 ──
  let camX = 0, camY = EYE;
  let mx = 0, my = 0, tmx = 0, tmy = 0;
  // 指针在画布上的位置：靠近的机柜会被照亮
  let ptrClientX = 0, ptrClientY = 0;
  let ptrMoved = -10, ptrOn = 0;
  window.addEventListener("pointermove", (e) => {
    if (e.pointerType !== "mouse") return;
    ptrClientX = e.clientX;
    ptrClientY = e.clientY;
    ptrMoved = time;
    tmx = (e.clientX / window.innerWidth) * 2 - 1;
    tmy = (e.clientY / window.innerHeight) * 2 - 1;
  }, { passive: true });

  const px = (x: number, z: number) => vpx + (f * (x - camX)) / z;
  const py = (y: number, z: number) => vpy - (f * (y - camY)) / z;
  const fog = (z: number) => Math.exp(-z * 0.062);
  const smooth = (a: number, b: number, v: number) => {
    const t = clamp((v - a) / (b - a), 0, 1);
    return t * t * (3 - 2 * t);
  };

  let time = 0;
  let travel = 0;
  // 周期性扫描光波的位置（相对镜头的深度），小于 NEAR 表示当前没有
  let waveZ = -1;
  let nextWave = 0;

  // 机柜"开通"事件：随机一个机柜被自下而上扫描，结束后一道光沿地面奔向走廊尽头
  const DEPLOY_DUR = 1.2;
  const deploys = new Map<number, number>(); // 机柜 key → 开始时间
  let nextDeploy = 3.2;
  let pktCursor = 0;

  // 开场跃迁时从尽头向外飞散的光线
  const streaks: { cos: number; sin: number; s: number; o: number }[] = [];
  for (let i = 0; i < 90; i++) {
    const ang = prnd() * Math.PI * 2;
    streaks.push({ cos: Math.cos(ang), sin: Math.sin(ang), s: 1.2 + prnd() * 1.6, o: prnd() });
  }

  // 漂浮的微尘，增加纵深感
  const motes: { x: number; y: number; z: number; ph: number }[] = [];
  for (let i = 0; i < 70; i++) {
    motes.push({ x: prnd() * 2 - 1, y: 0.1 + prnd() * (CEIL - 0.2), z: NEAR + prnd() * 22, ph: prnd() * 6.28 });
  }

  function update(dt: number) {
    time += dt;
    // 开场先快速推进，再缓缓前行
    const speed = 0.4 + 9 * Math.exp(-time * 1.6);
    travel += speed * dt;
    ptrOn += ((time - ptrMoved < 2.5 ? 1 : 0) - ptrOn) * Math.min(1, dt * 4);
    mx += (tmx - mx) * Math.min(1, dt * 3);
    my += (tmy - my) * Math.min(1, dt * 3);

    if (waveZ > NEAR) {
      waveZ -= (time < 3 ? BOOT_SPEED : 15) * dt;
    } else if (time >= nextWave) {
      waveZ = WAVE_START;
      nextWave = time < 1 ? 8 : time + 7.5;
    }

    for (const p of packets) {
      p.z += p.v * dt;
      if (p.z < NEAR - p.len || p.z > DEPTH + p.len) spawn(p, false);
    }

    if (time >= nextDeploy) {
      nextDeploy = time + 0.45 + prnd() * 0.9;
      const i = Math.floor(travel / PITCH) + 3 + Math.floor(prnd() * 14);
      deploys.set(rackKey(i, prnd() < 0.5 ? 0 : 1), time);
    }
    for (const [key, t0] of deploys) {
      if (time - t0 < DEPLOY_DUR) continue;
      deploys.delete(key);
      const p = packets[pktCursor++ % packets.length];
      p.rail = key % 2 ? 3 : 2;
      p.z = Math.floor(key / 2) * PITCH - travel + RACK_W / 2;
      p.v = 20;
      p.len = 3.2;
      p.c = 4;
    }

    for (const m of motes) {
      m.z -= (speed + 0.12) * dt;
      if (m.z < NEAR) m.z = 14 + prnd() * 8;
    }
  }

  function line(x0: number, y0: number, x1: number, y1: number) {
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x1, y1);
    ctx.stroke();
  }

  function draw() {
    camX = mx * A * 0.22;
    camY = EYE - my * 0.18;
    vpx = W / 2 - mx * W * 0.015;
    vpy = H * 0.64 - my * H * 0.01;
    // 指针高亮淡出后不再读取布局
    const hoverOn = ptrOn > 0.001;
    const rect = hoverOn ? canvas.getBoundingClientRect() : null;
    const ptrX = rect ? ptrClientX - rect.left : 0;
    const ptrY = rect ? ptrClientY - rect.top : 0;

    ctx.globalCompositeOperation = "source-over";
    ctx.globalAlpha = 1;
    ctx.clearRect(0, 0, W, H);
    ctx.globalCompositeOperation = "lighter";

    const intro = smooth(0, 1.4, time) * dim;
    const booted = time > 4;
    const waveOn = waveZ > NEAR && time >= BOOT_AT;

    // 走廊尽头的光
    const flash = Math.exp(-(((time - BOOT_AT) / 0.22) ** 2));
    const glowR = Math.max(W, H) * 0.42;
    const glow = ctx.createRadialGradient(vpx, vpy, 0, vpx, vpy, glowR);
    glow.addColorStop(0, `rgba(190,245,255,${(0.42 + flash * 0.5) * intro + flash * 0.3})`);
    glow.addColorStop(0.1, `rgba(46,160,255,${(0.24 + flash * 0.25) * intro})`);
    glow.addColorStop(0.45, `rgba(30,70,220,${0.07 * intro})`);
    glow.addColorStop(1, "rgba(20,40,160,0)");
    ctx.fillStyle = glow;
    ctx.fillRect(vpx - glowR, vpy - glowR, glowR * 2, glowR * 2);

    // 光波出发的瞬间，尽头的光再亮一下
    const pulse = waveOn ? Math.exp(-(((WAVE_START - waveZ) / 7) ** 2)) : 0;

    // 横向拉长的镜头光晕
    const fw = W * (0.24 + pulse * 0.1 + flash * 0.14);
    const flare = ctx.createLinearGradient(vpx - fw, 0, vpx + fw, 0);
    flare.addColorStop(0, "rgba(46,200,255,0)");
    flare.addColorStop(0.5, `rgba(215,250,255,${Math.min(1, (0.55 + flash + pulse * 0.5) * intro)})`);
    flare.addColorStop(1, "rgba(46,200,255,0)");
    ctx.fillStyle = flare;
    ctx.fillRect(vpx - fw, vpy - 1, fw * 2, 2);
    ctx.globalAlpha = 0.22;
    ctx.fillRect(vpx - fw, vpy - 6, fw * 2, 12);
    ctx.globalAlpha = 1;

    // 尽头的光在地面上的反光
    const ry = py(0, 2);
    const refl = ctx.createLinearGradient(0, vpy, 0, ry);
    refl.addColorStop(0, `rgba(120,220,255,${(0.07 + pulse * 0.08 + flash * 0.1) * intro})`);
    refl.addColorStop(1, "rgba(46,160,255,0)");
    ctx.fillStyle = refl;
    // 多层叠加，让光带边缘柔和
    for (const hw of REFLECT_W) {
      ctx.beginPath();
      ctx.moveTo(vpx, vpy);
      ctx.lineTo(px(A * hw, 2), ry);
      ctx.lineTo(px(-A * hw, 2), ry);
      ctx.closePath();
      ctx.fill();
    }

    // 开场跃迁：光线从尽头向四周飞散，随后迅速消退
    const warp = (time < 0.25 ? time / 0.25 : Math.exp(-(time - 0.25) * 1.9)) * dim;
    if (warp > 0.02) {
      const R = Math.hypot(W, H) * 0.62;
      ctx.lineWidth = 1.2;
      for (const st of streaks) {
        const h = (time * st.s + st.o) % 1;
        const r1 = h * h * R + 24;
        const r0 = r1 * 0.68;
        ctx.strokeStyle = `rgba(150,228,255,${warp * h * 0.6})`;
        line(vpx + st.cos * r0, vpy + st.sin * r0, vpx + st.cos * r1, vpy + st.sin * r1);
      }
    }

    // 地面与天花板的纵向线
    ctx.lineWidth = 1;
    for (let k = -4; k <= 4; k++) {
      const x = (k / 4) * A;
      for (const y of PLANES) {
        const nx = px(x, NEAR), ny = py(y, NEAR);
        const g = ctx.createLinearGradient(nx, ny, vpx, vpy);
        g.addColorStop(0, `rgba(60,170,255,${(y ? 0.1 : 0.26) * intro})`);
        g.addColorStop(1, "rgba(60,170,255,0)");
        ctx.strokeStyle = g;
        line(nx, ny, vpx, vpy);
      }
    }

    // 横向线随镜头前进而流动
    const first = Math.floor(travel / PITCH);
    for (let i = first; i < first + DEPTH; i++) {
      if (i % 2) continue;
      const z = i * PITCH - travel;
      if (z < NEAR) continue;
      const a = fog(z) * intro;
      ctx.strokeStyle = `rgba(60,170,255,${a * 0.22})`;
      line(px(-A, z), py(0, z), px(A, z), py(0, z));
      ctx.strokeStyle = `rgba(60,170,255,${a * 0.08})`;
      line(px(-A, z), py(CEIL, z), px(A, z), py(CEIL, z));
    }

    // 天花板灯管
    for (let i = first - 1; i < first + DEPTH; i++) {
      if (i % 2) continue;
      const z0 = Math.max(NEAR, i * PITCH - travel + 0.2);
      const z1 = i * PITCH - travel + 1.3;
      if (z1 <= NEAR) continue;
      // 贴近镜头的灯管渐隐，避免划过导航栏时过于抢眼
      const a = fog(z0) * intro * (0.35 + 0.65 * smooth(1.5, 7, z0));
      for (const sx of TUBE_X) {
        const x0 = px(sx * A, z0), y0 = py(CEIL, z0), x1 = px(sx * A, z1), y1 = py(CEIL, z1);
        ctx.lineWidth = Math.min(10, (f * 0.07) / z0);
        ctx.strokeStyle = `rgba(46,160,255,${a * 0.14})`;
        line(x0, y0, x1, y1);
        ctx.lineWidth = clamp((f * 0.012) / z0, 0.6, 2.5);
        ctx.strokeStyle = `rgba(200,245,255,${a * 0.5})`;
        line(x0, y0, x1, y1);
      }
    }

    // 机柜
    const ledW = f * A * 0.05, ledH = f * 0.045;
    for (let side = 0; side < 2; side++) {
      const wx = side ? A : -A;
      for (let i = first - 1; i < first + DEPTH; i++) {
        const zr = i * PITCH - travel;
        const z1 = zr + RACK_W;
        if (z1 <= NEAR + 0.05) continue;
        const z0 = Math.max(NEAR, zr);
        const rack = getRack(i, side);
        const zc = zr + RACK_W / 2;
        const base = fog(zc) * smooth(NEAR, 1.8, z1) * dim;
        const on = booted ? 1 : smooth(0, 0.35, time - rack.tOn);
        const t0d = deploys.get(rackKey(i, side));
        const dp = t0d === undefined ? -1 : (time - t0d) / DEPLOY_DUR;
        const hover = hoverOn ? ptrOn * Math.exp(-((px(wx, zc) - ptrX) ** 2 + (py(RACK_H / 2, zc) - ptrY) ** 2) / 26000) : 0;
        const boost =
          (waveOn ? Math.exp(-(((zc - waveZ) / 1.8) ** 2)) : 0) +
          (dp >= 0 ? Math.sin(Math.min(1, dp) * Math.PI) * 0.8 : 0) +
          hover * 0.7;

        const xa = px(wx, z0), xb = px(wx, z1);
        const ta = py(RACK_H, z0), tb = py(RACK_H, z1);
        const ba = py(0, z0), bb = py(0, z1);

        // 机柜外框
        ctx.beginPath();
        ctx.moveTo(xa, ta);
        ctx.lineTo(xb, tb);
        ctx.lineTo(xb, bb);
        ctx.lineTo(xa, ba);
        ctx.closePath();
        ctx.fillStyle = `rgba(30,90,255,${base * (0.03 + on * 0.04 + boost * 0.18)})`;
        ctx.fill();
        ctx.lineWidth = 1;
        ctx.strokeStyle = `rgba(70,170,255,${base * (0.1 + on * 0.2 + boost * 0.7)})`;
        ctx.stroke();

        if (on <= 0) continue;
        const detailed = zr < 18;
        const zl = zr + 0.07, zw = RACK_W - 0.14;

        // 设备面板的分隔线
        if (detailed && zl > NEAR) {
          const lx0 = px(wx, zl), lx1 = px(wx, zl + zw);
          ctx.beginPath();
          for (let r = 0; r < ROWS; r++) {
            const y = 0.2 + (r * (RACK_H - 0.35)) / ROWS;
            ctx.moveTo(lx0, py(y, zl));
            ctx.lineTo(lx1, py(y, zl + zw));
          }
          ctx.strokeStyle = `rgba(120,180,230,${base * on * 0.14})`;
          ctx.stroke();
        }

        // 指示灯
        let fill = -1;
        for (let r = 0; r < ROWS; r++) {
          const leds = rack.rows[r];
          const y = 0.2 + ((r + 0.5) * (RACK_H - 0.35)) / ROWS;
          const count = detailed ? leds.length : Math.min(1, leds.length);
          for (let k = 0; k < count; k++) {
            const led = leds[k];
            const z = zl + led.u * zw;
            if (z < NEAR) continue;
            const since = time - rack.tOn - led.delay;
            if (!booted && since < 0) continue;
            let b = led.rate && Math.sin(time * led.rate + led.phase) < 0 ? 0.22 : 1;
            // 刚点亮时闪烁几下
            if (!booted && since < 0.3 && Math.sin(since * 70) < 0) b *= 0.2;
            const a = Math.min(1, base * b * (0.95 + boost * 1.6));
            const x = px(wx, z), yy = py(y, z);
            const w = clamp(ledW / (z * z), 1, 6);
            const h = clamp(ledH / z, 1, 5);
            if (led.c !== fill) ctx.fillStyle = LED_FILL[(fill = led.c)];
            ctx.globalAlpha = a;
            ctx.fillRect(x - w / 2, yy - h / 2, w, h);
            if (h > 2.5) {
              ctx.globalAlpha = a * 0.14;
              ctx.fillRect(x - w * 1.5, yy - h * 1.5, w * 3, h * 3);
            }
            // 地面倒影
            if (r < 6) {
              ctx.globalAlpha = a * 0.22 * (1 - r / 6);
              ctx.fillRect(x - w / 2, py(-y, z) - h, w, h * 2);
            }
          }
        }
        ctx.globalAlpha = 1;

        // 开通扫描线：自下而上扫过整个机柜
        if (dp >= 0 && dp < 1) {
          const ys = dp * RACK_H;
          ctx.lineWidth = clamp((f * 0.02) / zc, 1, 3);
          ctx.strokeStyle = `rgba(225,250,255,${Math.min(1, base * 2.4)})`;
          line(xa, py(ys, z0), xb, py(ys, z1));
        }
      }
    }

    // 微尘
    ctx.fillStyle = "rgb(160,230,255)";
    for (const m of motes) {
      const y = m.y + Math.sin(time * 0.6 + m.ph) * 0.08;
      const sz = clamp((f * 0.012) / m.z, 0.6, 2.5);
      ctx.globalAlpha = fog(m.z) * 0.55 * intro * smooth(NEAR, 1.6, m.z);
      ctx.fillRect(px(m.x * A * 0.92, m.z), py(y, m.z), sz, sz);
    }
    ctx.globalAlpha = 1;

    // 扫描光波：一个沿走廊截面的光框冲向镜头
    if (waveOn) {
      const a = fog(waveZ) * dim * (time < 3 ? 1 : 0.55);
      const x0 = px(-A, waveZ), x1 = px(A, waveZ);
      const y0 = py(CEIL, waveZ), y1 = py(0, waveZ);
      const lw = clamp((f * 0.02) / waveZ, 1, 5);
      ctx.lineWidth = lw * 5;
      ctx.strokeStyle = `rgba(46,200,255,${a * 0.16})`;
      ctx.strokeRect(x0, y0, x1 - x0, y1 - y0);
      ctx.lineWidth = lw;
      ctx.strokeStyle = `rgba(210,250,255,${a * 0.85})`;
      ctx.strokeRect(x0, y0, x1 - x0, y1 - y0);
      // 余波
      const zt = waveZ + 1.6;
      ctx.lineWidth = Math.max(1, lw * 0.6);
      ctx.strokeStyle = `rgba(46,200,255,${fog(zt) * dim * 0.35})`;
      ctx.strokeRect(px(-A, zt), py(CEIL, zt), px(A, zt) - px(-A, zt), py(0, zt) - py(CEIL, zt));
    }

    // 数据流
    if (time > 1.2) {
      const pa = smooth(1.2, 2.6, time) * dim;
      for (const p of packets) {
        const rail = RAILS[p.rail];
        const zh = Math.max(NEAR, p.z);
        const zt = Math.max(NEAR, p.z - Math.sign(p.v) * p.len);
        if (zh === zt) continue;
        const x = rail.x * A;
        const hx = px(x, zh), hy = py(rail.y, zh);
        const tx = px(x, zt), ty = py(rail.y, zt);
        const a = fog(zh) * pa;
        const g = ctx.createLinearGradient(tx, ty, hx, hy);
        g.addColorStop(0, `rgba(${LED_COLORS[p.c]},0)`);
        g.addColorStop(1, `rgba(${LED_COLORS[p.c]},${a})`);
        ctx.strokeStyle = g;
        ctx.lineWidth = clamp((f * 0.016) / zh, 0.8, 3);
        line(tx, ty, hx, hy);
      }
    }

    // 泛光
    mctx.globalCompositeOperation = "copy";
    mctx.drawImage(canvas, 0, 0, mid.width, mid.height);
    bctx.globalCompositeOperation = "copy";
    bctx.drawImage(mid, 0, 0, bloom.width, bloom.height);
    ctx.globalAlpha = 0.75;
    ctx.drawImage(bloom, 0, 0, W, H);
    ctx.globalAlpha = 1;

    // 清理已经走过的机柜
    if (racks.size > DEPTH * 6) {
      for (const key of racks.keys()) {
        if (key < (first - 2) * 2) racks.delete(key);
      }
    }
  }

  // ── 运行控制：离开视口或页面隐藏时暂停 ──
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  let visible = true;
  let raf = 0;
  let last = 0;

  const canRun = () => W > 0 && !reduced.matches && visible && !document.hidden;

  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    update(dt);
    draw();
    raf = canRun() ? requestAnimationFrame(frame) : 0;
  }

  function schedule() {
    if (raf || !canRun()) return;
    last = performance.now();
    raf = requestAnimationFrame(frame);
  }

  // 减少动态效果时只画一帧已点亮的静态画面
  function drawStill() {
    time = Math.max(time, 10);
    waveZ = -1;
    draw();
  }

  function refresh() {
    resize();
    if (reduced.matches) drawStill();
    else {
      draw();
      schedule();
    }
  }

  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    schedule();
  }).observe(stage);
  document.addEventListener("visibilitychange", schedule);
  reduced.addEventListener("change", refresh);
  // 首次 observe 即会触发回调，完成初始尺寸计算与绘制
  new ResizeObserver(refresh).observe(stage);
</script>
