---
// 渲染与后台一致的 lucide 图标
import { icons } from "./icons";

interface Props {
  name: string;
  class?: string;
  [attr: string]: unknown;
}

const { name, class: className = "", ...attrs } = Astro.props;
const body = icons[name];
if (!body) throw new Error(`未知图标：${name}`);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`lucide lucide-${name} ${className}`.trim()}
  aria-hidden="true"
  {...attrs}
  set:html={body}
/>
