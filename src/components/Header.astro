---
interface Props {
  variant?: "dark" | "light";
}
const { variant = "dark" } = Astro.props;
const isDark = variant === "dark";

const isHome = Astro.url.pathname === "/";
const links = [
  { label: "功能", href: isHome ? "#features" : "/#features" },
  { label: "部署", href: isHome ? "#deploy" : "/#deploy" },
  { label: "价格", href: isHome ? "#pricing" : "/#pricing" },
  { label: "FAQ", href: isHome ? "#faq" : "/#faq" },
  { label: "文档", href: "https://docs.huohuastudio.com/novaix", ext: true },
  { label: "GitHub", href: "https://github.com/huohuastudio/novaix-releases", ext: true },
];
---

<header id="hdr" class="fixed top-0 z-50 w-full transition-[background,box-shadow] duration-300" data-variant={variant}>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class:list={["flex items-center gap-2 font-display text-[1.05rem] font-bold tracking-tight", isDark ? "text-white" : "text-zinc-900 dark:text-white"]}>
      <img src="/logo.svg" alt="" class="h-7 w-7" aria-hidden="true" />
      Novaix
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.ext ? "_blank" : undefined}
          rel={l.ext ? "noopener noreferrer" : undefined}
          class:list={["hdr-link inline-flex items-center gap-0.5 text-[0.84rem] transition-colors", isDark ? "text-slate-300/70 hover:text-white" : "text-zinc-500 hover:text-zinc-900 dark:text-slate-300/70 dark:hover:text-white"]}
        >
          {l.label}
          {l.ext && (
            <svg class="h-3 w-3 -translate-y-px opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
            </svg>
          )}
        </a>
      ))}
      <a
        href="https://github.com/huohuastudio/novaix-releases/releases"
        target="_blank"
        rel="noopener noreferrer"
        class:list={["rounded-lg px-4 py-1.5 text-[0.84rem] font-medium transition-colors", isDark ? "bg-white/10 text-white backdrop-blur-sm hover:bg-white/20" : "bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-white/10 dark:hover:bg-white/20"]}
      >
        下载
      </a>
    </nav>

    <button id="mbtn" class="md:hidden" aria-label="菜单">
      <svg class:list={["h-5 w-5", isDark ? "text-slate-300" : "text-zinc-600 dark:text-slate-300"]} fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="mmenu" class:list={["hidden border-t px-6 py-5 backdrop-blur-xl md:hidden", isDark ? "border-white/10 bg-depth/95" : "border-zinc-100 bg-white/95 dark:border-white/10 dark:bg-depth/95"]}>
    {links.map((l) => (
      <a href={l.href} target={l.ext ? "_blank" : undefined} class:list={["flex items-center gap-0.5 py-2 text-sm", isDark ? "text-slate-300" : "text-zinc-600 dark:text-slate-300"]}>
        {l.label}
        {l.ext && (
          <svg class="h-3 w-3 -translate-y-px opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
          </svg>
        )}
      </a>
    ))}
    <a
      href="https://github.com/huohuastudio/novaix-releases/releases"
      target="_blank"
      class:list={["mt-3 block rounded-lg py-2 text-center text-sm font-medium", isDark ? "bg-white/10 text-white" : "bg-zinc-900 text-white dark:bg-white/10"]}
    >
      下载
    </a>
  </div>
</header>

<script>
  const hdr = document.getElementById("hdr")!;
  const mbtn = document.getElementById("mbtn")!;
  const mmenu = document.getElementById("mmenu")!;

  const variant = hdr.dataset.variant;
  const isLight = variant === "light";
  const isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;

  let scrolled = false;
  const onScroll = () => {
    const now = scrollY > 16;
    if (now === scrolled) return;
    scrolled = now;
    if (now) {
      const useDark = !isLight || isDarkMode;
      hdr.style.backgroundColor = useDark ? "rgba(15,23,42,0.85)" : "rgba(255,255,255,0.85)";
      hdr.style.backdropFilter = "blur(16px) saturate(1.2)";
      hdr.style.webkitBackdropFilter = "blur(16px) saturate(1.2)";
      hdr.style.boxShadow = useDark ? "0 1px 2px rgba(0,0,0,.2)" : "0 1px 2px rgba(0,0,0,.06)";
    } else {
      hdr.style.backgroundColor = "";
      hdr.style.backdropFilter = "";
      hdr.style.webkitBackdropFilter = "";
      hdr.style.boxShadow = "";
    }
  };
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  mbtn.onclick = () => mmenu.classList.toggle("hidden");
  mmenu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => mmenu.classList.add("hidden")));
</script>
