---
interface Plugin {
  id: string;
  name: string;
  version: string;
  description: string;
  type: string;
  author: { name: string; url: string };
}

interface Theme {
  id: string;
  name: string;
  version: string;
  description: string;
  author: { name: string; url: string };
  screenshot?: string;
}

const BASE = "https://raw.githubusercontent.com/huohuastudio/novaix-releases/main";

let plugins: Plugin[] = [];
let themes: Theme[] = [];

try {
  const [pluginRes, themeRes] = await Promise.all([
    fetch(`${BASE}/plugins/index.json`),
    fetch(`${BASE}/themes/index.json`),
  ]);
  if (pluginRes.ok) plugins = (await pluginRes.json()).plugins ?? [];
  if (themeRes.ok) themes = (await themeRes.json()).themes ?? [];
} catch {
  // 构建时获取失败则使用空数组
}

const typeLabels: Record<string, string> = {
  payment: "支付",
  oauth: "登录",
  sms: "短信",
  notify: "通知",
  captcha: "验证",
  extension: "扩展",
};

const typeColors: Record<string, string> = {
  payment: "text-emerald-600 dark:text-emerald-300",
  oauth: "text-sky-600 dark:text-sky-300",
  sms: "text-amber-600 dark:text-amber-300",
  notify: "text-violet-600 dark:text-violet-300",
  captcha: "text-rose-600 dark:text-rose-300",
};

const cardClass =
  "rounded-md border border-zinc-200 dark:border-white/[0.08] bg-white dark:bg-white/[0.02] p-5 transition-colors hover:border-brand/60 hover:bg-brand/[0.06]";
---
{(plugins.length > 0 || themes.length > 0) && (
  <section class="page-section">
    <div class="mx-auto max-w-6xl">
      <div data-animate>
        <h2 class="section-title">
          插件与主题
        </h2>
        <p class="section-lead">
          通过插件扩展系统能力，一键安装，即装即用。
          <a
            href="https://github.com/huohuastudio/novaix-releases"
            target="_blank"
            rel="noopener noreferrer"
            class="ml-1 text-brand dark:text-glow underline-offset-4 hover:underline"
          >
            提交你的插件
          </a>
        </p>
      </div>

      {/* 插件 */}
      {plugins.length > 0 && (
        <div class="mt-12" data-animate style="--stagger:.1s">
          <h3 class="mb-5 text-sm font-semibold text-zinc-900 dark:text-white">插件</h3>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {plugins.map((plugin) => (
              <div class={cardClass}>
                <div class="flex items-center justify-between gap-3">
                  <h4 class="font-display text-[0.95rem] font-semibold text-zinc-900 dark:text-white">
                    {plugin.name}
                  </h4>
                  <span class:list={["shrink-0 text-xs font-medium", typeColors[plugin.type] ?? "text-zinc-500 dark:text-slate-400"]}>
                    {typeLabels[plugin.type] ?? plugin.type}
                  </span>
                </div>
                <p class="mt-2 text-[0.84rem] leading-relaxed text-zinc-500 dark:text-slate-400">
                  {plugin.description}
                </p>
                <div class="mt-4 flex items-center justify-between text-xs text-zinc-500 dark:text-slate-500">
                  <span>{plugin.author.name}</span>
                  <span class="font-mono">v{plugin.version}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* 主题 */}
      {themes.length > 0 && (
        <div class:list={[plugins.length > 0 ? "mt-14" : "mt-12"]} data-animate>
          <h3 class="mb-5 text-sm font-semibold text-zinc-900 dark:text-white">主题</h3>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {themes.map((theme) => (
              <div class={cardClass}>
                <h4 class="font-display text-[0.95rem] font-semibold text-zinc-900 dark:text-white">
                  {theme.name}
                </h4>
                <p class="mt-2 text-[0.84rem] leading-relaxed text-zinc-500 dark:text-slate-400">
                  {theme.description}
                </p>
                <div class="mt-4 flex items-center justify-between text-xs text-zinc-500 dark:text-slate-500">
                  <span>{theme.author.name}</span>
                  <span class="font-mono">v{theme.version}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
