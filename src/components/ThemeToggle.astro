---
// 主题切换按钮：图标随 <html data-theme> 显示（见 global.css），点击逻辑在 Header 脚本里
interface Props {
  class?: string | string[];
}
const { class: className } = Astro.props;
---

<button type="button" class:list={["theme-toggle flex h-8 w-8 items-center justify-center rounded-lg transition-colors", className]}>
  <svg data-icon="light" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path stroke-linecap="round" d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
  </svg>
  <svg data-icon="dark" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 14.2A8.5 8.5 0 019.8 3.5a8.5 8.5 0 1010.7 10.7z" />
  </svg>
  <svg data-icon="auto" class="h-[1.05rem] w-[1.05rem]" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="4.5" width="18" height="12" rx="2" />
    <path stroke-linecap="round" d="M8.5 20h7M12 16.5V20" />
  </svg>
</button>
