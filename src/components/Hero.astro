---
import WaveGrid from "./bg/WaveGrid.astro";

const stats = [
  { value: "30+", label: "扩展插件" },
  { value: "14", label: "CMS 模块" },
  { value: "11", label: "Linux 发行版" },
  { value: "3", label: "数据库引擎" },
];
---

<section class="relative flex min-h-screen flex-col overflow-hidden bg-depth">
  <WaveGrid />

  <!-- 渐变覆盖层 -->
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_45%,transparent_20%,rgba(15,23,42,0.6)_100%)]"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-depth to-transparent"></div>

  <!-- 内容 -->
  <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pt-32 pb-20 text-center">
    <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-[3.8rem] lg:leading-[1.1]">
      一个文件<br class="sm:hidden" />，完整的主机销售平台
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-300/80">
      面向中小型 VPS 服务商的 IDC 管理系统。<br class="hidden sm:inline" />
      单二进制部署，内置数据库，开箱即用。
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://github.com/huohuastudio/novaix-releases/releases"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 rounded-xl bg-brand px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        下载安装
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a
        href="https://docs.huohuastudio.com/novaix"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-white/15 px-7 py-3 text-sm font-medium text-slate-200 transition-all hover:border-white/30 hover:bg-white/5"
      >
        阅读文档
      </a>
    </div>
  </div>

  <!-- 统计数据栏 -->
  <div class="relative z-10 border-t border-white/[0.06]">
    <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-12 gap-y-4 px-6 py-6 sm:justify-between">
      {stats.map((s) => (
        <div class="flex items-baseline gap-2">
          <span class="font-display text-2xl font-bold text-white">{s.value}</span>
          <span class="text-sm text-slate-400">{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Dashboard 截图预览 -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 pb-0">
    <div>
      <img
        src="/screenshots/dashboard.png"
        alt="Novaix 管理后台"
        class="w-full rounded-xl"
        loading="eager"
      />
    </div>
    <div class="pointer-events-none h-20 bg-gradient-to-t from-depth to-transparent"></div>
  </div>
</section>
