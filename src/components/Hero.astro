---
import RackAisle from "./bg/RackAisle.astro";

const stats = [
  { value: "30+", label: "扩展插件" },
  { value: "14", label: "CMS 模块" },
  { value: "11", label: "Linux 发行版" },
  { value: "3", label: "数据库引擎" },
];

// 标题逐字显现，按行分组避免在词中间换行
const headline = ["一个文件，", "完整的主机销售平台"];
let charIndex = 0;
const lines = headline.map((text) => [...text].map((char) => ({ char, i: charIndex++ })));
---

<section class="relative overflow-hidden bg-depth text-slate-300">
  <!-- 首屏舞台 -->
  <div class="relative flex min-h-[86svh] flex-col">
    <RackAisle />

    <!-- 文字区域压暗，保证可读性 -->
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_42%_at_50%_40%,rgba(5,7,13,0.85),transparent_100%)] sm:bg-[radial-gradient(ellipse_46%_36%_at_50%_40%,rgba(5,7,13,0.72),transparent_100%)]"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-depth/80 to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-depth via-depth/70 to-transparent"></div>

    <!-- 内容 -->
    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 pt-28 pb-16 text-center">
      <h1
        aria-label={headline.join("")}
        class="font-display text-[min(8.4vw,2.25rem)] font-bold leading-tight tracking-tight text-white drop-shadow-[0_0_28px_rgba(46,160,255,0.45)] sm:text-5xl lg:text-[3.8rem] lg:leading-[1.1]"
      >
        {lines.map((line) => (
          <span class="inline-block" aria-hidden="true">
            {line.map(({ char, i }) => (
              <span class="hero-char" style={`--i:${i}`}>{char}</span>
            ))}
          </span>
        ))}
      </h1>

      <p class="hero-in mx-auto mt-6 max-w-xl text-base leading-relaxed text-slate-300/85 sm:text-lg" style="--d:1.25s">
        面向中小型 VPS 服务商的 IDC 管理系统。<br />
        单二进制部署，内置数据库，开箱即用。
      </p>

      <div class="hero-in mt-10 flex flex-wrap items-center justify-center gap-4" style="--d:1.4s">
        <a
          href="https://github.com/huohuastudio/novaix-releases/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="group btn-primary"
        >
          下载安装
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a
          href="https://novaix.huohuastudio.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          在线演示
        </a>
        <a
          href="https://docs.huohuastudio.com/novaix"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ghost"
        >
          阅读文档
        </a>
      </div>
    </div>

    <!-- 统计数据栏 -->
    <div class="hero-in relative z-10" style="--d:1.7s">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-12 gap-y-4 px-6 pt-6 pb-10 sm:justify-between">
        {stats.map((s) => (
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl font-bold text-white">{s.value}</span>
            <span class="text-sm text-slate-400">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Dashboard 截图预览：随滚动从倾斜放平 -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 [perspective:1800px]">
    <div class="pointer-events-none absolute inset-x-[20%] top-0 h-24 rounded-[100%] bg-brand/30 blur-3xl"></div>
    <div id="hero-shot" class="relative origin-[50%_70%] will-change-transform">
      <img
        src="/screenshots/dashboard.png"
        alt="Novaix 管理后台"
        class="w-full rounded-xl shadow-[0_-12px_90px_-20px_rgba(46,160,255,0.6)] ring-1 ring-white/10"
        loading="eager"
      />
    </div>
    <div class="pointer-events-none h-20 bg-gradient-to-t from-depth to-transparent"></div>
  </div>
</section>

<style>
  .hero-char {
    display: inline-block;
    animation: hero-char 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.55s + var(--i) * 45ms);
  }

  .hero-in {
    animation: hero-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes hero-char {
    from {
      opacity: 0;
      transform: translateY(0.35em) scale(1.25);
      filter: blur(12px);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-char,
    .hero-in {
      animation: none;
    }
  }
</style>

<script>
  const shot = document.getElementById("hero-shot")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  let ticking = false;
  let lastP = -1;

  function apply() {
    ticking = false;
    if (reduced.matches) {
      shot.style.transform = "";
      lastP = -1;
      return;
    }
    const vh = window.innerHeight;
    // 用父容器的位置计算进度，避免倾斜角度反过来干扰测量
    const top = shot.parentElement!.getBoundingClientRect().top;
    const p = Math.min(1, Math.max(0, (vh - top) / (vh * 0.75)));
    // 截图放平后继续滚动时进度不再变化，跳过样式写入
    if (p === lastP) return;
    lastP = p;
    const e = p * p * (3 - 2 * p);
    shot.style.transform = `rotateX(${(1 - e) * 26}deg) scale(${0.9 + e * 0.1})`;
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(apply);
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  reduced.addEventListener("change", apply);
  apply();
</script>
