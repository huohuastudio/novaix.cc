---

<section id="features" class="px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div data-animate>
      <h2 class="font-display text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50">
        产品能力
      </h2>
      <p class="mt-3 max-w-lg text-zinc-500 dark:text-zinc-400">
        从实例管理到商业运营，从安全认证到生态扩展，覆盖 IDC 运营全链路。
      </p>
    </div>

    <!-- Tab 导航 -->
    <div class="mt-10 flex gap-1 overflow-x-auto rounded-xl border border-zinc-200/80 bg-zinc-50 p-1 dark:border-zinc-700/80 dark:bg-zinc-900" data-animate style="--stagger:.1s">
      {tabs.map((tab, i) => (
        <button
          data-tab={tab.id}
          data-active={i === 0 ? "" : undefined}
          class="tour-tab shrink-0 rounded-lg px-5 py-2.5 text-sm font-medium text-zinc-500 transition-all hover:text-zinc-700 data-[active]:bg-white data-[active]:text-zinc-900 data-[active]:shadow-sm dark:text-zinc-400 dark:hover:text-zinc-200 dark:data-[active]:bg-zinc-800 dark:data-[active]:text-zinc-50"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Tab 内容 -->
    <div class="mt-8" data-animate style="--stagger:.15s">
      {tabs.map((tab, i) => (
        <div
          data-panel={tab.id}
          class:list={[
            "tour-panel grid items-center gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-14",
            i !== 0 && "hidden",
          ]}
        >
          <div>
            <h3 class="font-display text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">{tab.title}</h3>
            <p class="mt-3 leading-relaxed text-zinc-500 dark:text-zinc-400">{tab.description}</p>
            <ul class="mt-6 space-y-3">
              {tab.features.map((f) => (
                <li class="flex items-start gap-3 text-[0.9rem] text-zinc-600 dark:text-zinc-300">
                  <svg class="mt-[3px] h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <div class="magnify overflow-hidden rounded-lg shadow-lg">
              <img src={tab.image} alt={tab.imageAlt} class="w-full object-cover object-top" loading="lazy" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tour-tab");
  const panels = document.querySelectorAll<HTMLDivElement>(".tour-panel");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.tab;
      tabBtns.forEach((b) => {
        if (b.dataset.tab === id) b.setAttribute("data-active", "");
        else b.removeAttribute("data-active");
      });
      panels.forEach((p) => {
        p.classList.toggle("hidden", p.dataset.panel !== id);
      });
    });
  });
</script>
