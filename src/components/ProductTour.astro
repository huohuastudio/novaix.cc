---
// 产品能力：左侧功能列表，右侧为代码还原的后台界面展台
import "./tour/tour.css";
import Icon from "./demo/Icon.astro";
import InstancesTour from "./tour/modules/InstancesTour.astro";
import NetworkTour from "./tour/modules/NetworkTour.astro";
import OpsTour from "./tour/modules/OpsTour.astro";
import BillingTour from "./tour/modules/BillingTour.astro";
import SupplierTour from "./tour/modules/SupplierTour.astro";
import SecurityTour from "./tour/modules/SecurityTour.astro";
import CmsTour from "./tour/modules/CmsTour.astro";
import ExtendTour from "./tour/modules/ExtendTour.astro";

interface Feature {
  text: string;
  /** 悬停时在展台中高亮的区域：data-tour-target 的值，或 nav:菜单名 */
  spot?: string;
}

interface Module {
  id: string;
  label: string;
  icon: string;
  title: string;
  description: string;
  features: Feature[];
  stage: typeof InstancesTour;
}

const modules: Module[] = [
  {
    id: "instances",
    label: "实例管理",
    icon: "monitor-cog",
    title: "实例全生命周期管理",
    description: "容器与虚拟机统一管控，从创建到销毁的每个环节都有对应操作。支持 Linux 和 Windows，NAT 与独立 IP 自由选择。",
    features: [
      { text: "启停、重装、快照、重置密码、VNC 控制台", spot: "actions" },
      { text: "批量创建实例，一次下单开通多台", spot: "nav:实例管理" },
      { text: "升级/降级套餐，端口转发与防火墙", spot: "tabs" },
      { text: "Windows 完整支持（TPM/ISO 双挂载/密码重置）", spot: "nav:ISO 镜像" },
      { text: "SSE 实时任务追踪，操作状态自动刷新", spot: "tasks" },
    ],
    stage: InstancesTour,
  },
  {
    id: "network",
    label: "网络管理",
    icon: "network",
    title: "灵活的网络架构",
    description: "VPC 私有网络实现多实例内网互联，安全组精确控制流量。支持 IPv4/IPv6 双栈，共享 IP 与独立 IP 灵活搭配。",
    features: [
      { text: "VPC 私有网络，多实例安全互联", spot: "vpc" },
      { text: "安全组与 ACL 规则，精确控制出入站流量", spot: "nav:私有网络" },
      { text: "IP 池管理，批量分配与回收", spot: "pools" },
      { text: "共享 IP + NAT 端口转发，节省 IPv4 成本", spot: "nav:共享 IP" },
      { text: "IPv6 支持，纯 IPv6 套餐或 NAT+IPv6 灵活选择", spot: "ipv6" },
    ],
    stage: NetworkTour,
  },
  {
    id: "ops",
    label: "运维监控",
    icon: "activity",
    title: "企业级运维能力",
    description: "区域化管理全球节点，实时监控资源使用。HA 高可用确保业务零中断，仪表盘一眼掌握全局态势。",
    features: [
      { text: "区域管理，节点按地理位置分组", spot: "nav:区域管理" },
      { text: "节点实时监控，CPU/内存/磁盘/网络趋势图", spot: "charts" },
      { text: "节点组集群，在线热迁移", spot: "nav:节点管理" },
      { text: "HA 高可用，节点故障自动疏散实例", spot: "nav:告警记录" },
      { text: "仪表盘：世界地图、收入趋势、资源进度条", spot: "nav:仪表盘" },
    ],
    stage: OpsTour,
  },
  {
    id: "billing",
    label: "商业运营",
    icon: "shopping-cart",
    title: "完整的商业闭环",
    description: "从套餐定价到收款发票，一套系统覆盖 VPS 销售的全部商业环节。代理分销体系帮你快速建立分销网络。",
    features: [
      { text: "月付/季付/年付/小时计费，自动扣费与暂停", spot: "cycle" },
      { text: "多支付渠道，插件化扩展更多网关", spot: "nav:支付记录" },
      { text: "发票系统，用户自助申请，管理员审核", spot: "nav:发票管理" },
      { text: "工单系统，部门分类 / 指派 / SLA 时限", spot: "nav:工单系统" },
      { text: "代理分销，差异化返佣与折扣矩阵", spot: "nav:代理管理" },
    ],
    stage: BillingTour,
  },
  {
    id: "supplier",
    label: "供应商转售",
    icon: "cable",
    title: "对接上游，转售即开通",
    description: "把上游供应商的云服务器作为模块商品上架销售。用户付款后自动在上游下单开通，续费、到期暂停、逾期退订同步完成，没有自有机器也能开展业务。",
    features: [
      { text: "内置魔方业务系统、魔方财务、WHMCS、雨云插件", spot: "nav:供应商连接" },
      { text: "模块商品独立定价，与自营共用余额、订单与发票", spot: "nav:模块商品" },
      { text: "开通、续费、暂停、退订自动同步到上游", spot: "status" },
      { text: "操作排队执行、自动重试，异常进入待处理队列", spot: "attention" },
      { text: "上游余额查询与不足提醒，定时同步与对账", spot: "balance" },
    ],
    stage: SupplierTour,
  },
  {
    id: "security",
    label: "安全认证",
    icon: "shield-check",
    title: "多层安全防护",
    description: "从用户登录到敏感操作，每一步都有对应的安全策略。内置多种认证方式，40+ 项安全加固措施。",
    features: [
      { text: "TOTP 两步验证，敏感操作二次确认", spot: "totp" },
      { text: "社交登录（GitHub/Google/微信/OIDC + 插件扩展）", spot: "nav:插件" },
      { text: "实名认证（身份核验 + H5 人脸识别）", spot: "kyc" },
      { text: "人机验证（极验/reCAPTCHA/hCaptcha/Turnstile）", spot: "nav:插件" },
      { text: "HTTPS 强制、SSRF 防护、CSP 策略等 40+ 安全加固", spot: "nav:系统设置" },
    ],
    stage: SecurityTour,
  },
  {
    id: "cms",
    label: "站点建设",
    icon: "square-pen",
    title: "自建品牌官网",
    description: "内置 CMS 覆盖官网运营所需的全部内容模块，无需额外搭建营销站点。主题热切换，打造品牌差异化。",
    features: [
      { text: "14 个 CMS 子模块：公告、文章、FAQ、帮助中心等", spot: "modules" },
      { text: "自定义页面与导航菜单", spot: "pages" },
      { text: "主题市场，社区主题一键安装和切换", spot: "theme" },
      { text: "选购页面自动生成，支持区域与套餐筛选", spot: "nav:套餐管理" },
      { text: "SEO 优化，站点描述与关键词配置", spot: "nav:系统设置" },
    ],
    stage: CmsTour,
  },
  {
    id: "extend",
    label: "扩展生态",
    icon: "blocks",
    title: "开放与可扩展",
    description: "插件系统覆盖支付、短信、邮件、认证、通知五大类。Provisioning API 与 Webhook 开放集成，前端源码完全开源。",
    features: [
      { text: "JS 插件引擎，一键安装/热重载/导出打包", spot: "plugin-actions" },
      { text: "支付/短信/邮件/认证/通知 五大类插件", spot: "categories" },
      { text: "Provisioning API + Webhook 开放集成", spot: "nav:集成方" },
      { text: "CLI 管理工具，终端直接运维" },
      { text: "前端源码开源，深度定制无限制" },
    ],
    stage: ExtendTour,
  },
];
---

<section id="features" class="page-section">
  <div class="mx-auto max-w-6xl">
    <div data-animate>
      <h2 class="section-title">产品能力</h2>
      <p class="section-lead max-w-lg">从实例管理到供应商转售，从商业运营到生态扩展，覆盖 IDC 运营全链路。</p>
    </div>

    <div data-tour data-stopped class="mt-12 grid items-center gap-10 lg:mt-16 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-14">
      <!-- 功能列表 -->
      <div class="order-2 lg:order-1" data-animate style="--stagger:.1s">
        {modules.map((m, i) => (
          <div data-tour-item={m.id} data-active={i === 0 ? "" : undefined} class="group/item relative border-l border-zinc-200 dark:border-white/[0.08]">
            <span data-tour-progress class="tour-progress absolute top-0 -left-px h-full w-0.5 bg-brand dark:bg-glow dark:shadow-[0_0_10px_var(--color-glow)]"></span>
            <h3>
              <button
                type="button"
                id={`tour-tab-${m.id}`}
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`tour-detail-${m.id}`}
                class="flex w-full cursor-pointer items-center gap-3 py-3 pr-2 pl-5 text-left text-[0.95rem] font-medium text-zinc-500 transition-colors hover:text-zinc-900 group-data-[active]/item:text-zinc-900 dark:text-slate-400 dark:hover:text-white dark:group-data-[active]/item:text-white"
              >
                <Icon name={m.icon} class="size-[1.05rem] shrink-0 opacity-70 group-data-[active]/item:text-brand group-data-[active]/item:opacity-100 dark:group-data-[active]/item:text-glow" />
                {m.label}
              </button>
            </h3>
            <div id={`tour-detail-${m.id}`} role="region" aria-labelledby={`tour-tab-${m.id}`} class="tour-detail">
              <div>
                <div class="pr-2 pb-5 pl-5">
                  <p class="font-display text-lg font-bold tracking-tight text-zinc-900 dark:text-white">{m.title}</p>
                  <p class="mt-2 text-sm leading-relaxed text-zinc-500 dark:text-slate-400">{m.description}</p>
                  <ul class="mt-4 space-y-1">
                    {m.features.map((f) => (
                      <li
                        data-spot={f.spot}
                        class:list={[
                          "-mx-2 flex items-start gap-3 rounded-md px-2 py-1 text-[0.875rem] text-zinc-600 transition-colors dark:text-slate-300",
                          f.spot && "cursor-default hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-white/[0.05] dark:hover:text-white",
                        ]}
                      >
                        <span class="led mt-[0.6em]"></span>
                        {f.text}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- 展台 -->
      <div class="order-1 lg:order-2" data-animate style="--stagger:.15s">
        <div data-tour-column class="py-2 lg:py-10 lg:pr-6 xl:pr-0">
          <div data-tour-stack class="tour-stack">
            {modules.map((m, i) => (
              <m.stage initial={i === 0} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTour } from "./tour/tour";

  document.querySelectorAll<HTMLElement>("[data-tour]").forEach(initTour);
</script>
