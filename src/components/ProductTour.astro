    image: "/screenshots/vpcs.png",
    imageAlt: "VPC 网络管理",
  },
  {
    id: "ops",
    label: "运维监控",
    title: "企业级运维能力",
    description: "区域化管理全球节点，实时监控资源使用。HA 高可用确保业务零中断，仪表盘一眼掌握全局态势。",
    features: [
      "区域管理，节点按地理位置分组",
      "节点实时监控，CPU/内存/磁盘/网络趋势图",
      "节点组集群，在线热迁移",
      "HA 高可用，节点故障自动疏散实例",
      "仪表盘：世界地图、收入趋势、资源进度条",
